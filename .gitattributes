# gofmt emits LF; a CRLF checkout reads as unformatted.
*.go text eol=lf

# The go tool rewrites these with LF, so a CRLF checkout is dirty the moment it is touched.
go.mod text eol=lf
go.sum text eol=lf

# Fixtures encode exact line endings; git must not rewrite them. A pattern with an interior slash
# is anchored to this file's directory, so the leading **/ is what reaches the per-package testdata.
testdata/** -text
**/testdata/** -text
